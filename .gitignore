# Secrets / environment
.env
.env.*
!.env.example
.secrets.baseline

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Supabase CLI local link state
supabase/.temp/
supabase/.branches/

# Data — never commit ingested papers, parsed PDFs, or local dumps.
# Anchored to the repo root so it only matches the backend's runtime dir, not frontend/src/data/.
/data/
*.pdf
# ...but the curated classifier benchmark is committed test data, not a runtime dump.
!backend/tests/data/
!backend/tests/data/**

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
