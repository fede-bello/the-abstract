# Copy to `.env` and fill in. Never commit `.env`.
# Only secrets live here — all other config is in `config.toml` at the repo root.

# LLM auth. Two ways to run the classification/summarization models:
#  1. Claude subscription (default, no key): log in once with `claude` (or `claude setup-token`
#     for CI) — leave LLM_API_KEY blank and keep llm_backend = "auto" / "claude_code".
#  2. API key (any provider): set LLM_API_KEY and the model strings in config.toml to match
#     (e.g. "openai/gpt-4o-mini" with an OpenAI key). Set llm_backend = "litellm".
LLM_API_KEY=
# LlamaCloud — LlamaParse PDF parsing
LLAMA_CLOUD_API_KEY=

# Supabase Postgres (pgvector) — backend storage + RAG retrieval.
# Use the "Session pooler" connection string from Project Settings → Database,
# including your DB password. Secret — keep it here, never in config.toml.
SUPABASE_DB_URL=

# Supabase frontend client (public, RLS-gated — safe to expose in the Vite SPA build;
# Vite only exposes vars prefixed with VITE_ to the client bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SMTP — used to send the weekly digest email. For Gmail, SMTP_USERNAME is the address and
# SMTP_PASSWORD is a Gmail App Password (not your login password). Host/port are in config.toml.
SMTP_USERNAME=
SMTP_PASSWORD=
