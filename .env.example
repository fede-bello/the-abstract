# Copy to `.env` and fill in. Never commit `.env`.

# === Secrets ===
# Anthropic — LLM used for classification, summarization, and Q&A
ANTHROPIC_API_KEY=
# LlamaCloud — LlamaParse PDF parsing
LLAMA_CLOUD_API_KEY=

# === Optional overrides (defaults shown; uncomment to change) ===
# Ingestion
# MAX_RESULTS=25
# DAYS_BACK=7
# ARXIV_CATEGORIES=["cs.LG","cs.CL","cs.CV","cs.AI","cs.NE","stat.ML","math.OC","math.ST"]

# arXiv client + retry/backoff
# ARXIV_PAGE_SIZE=100
# ARXIV_REQUEST_DELAY_SECONDS=5.0
# ARXIV_NUM_RETRIES=1
# ARXIV_MAX_ATTEMPTS=6
# ARXIV_RETRY_BASE_DELAY_SECONDS=3.0
# ARXIV_RETRY_MAX_DELAY_SECONDS=60.0

# Runtime
# WORKFLOW_TIMEOUT_SECONDS=86400
# LOG_LEVEL=INFO
# DATA_DIR=data
