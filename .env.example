# Copy to `.env` and fill in. Never commit `.env`.
# Only secrets live here — all other config is in `config.toml` at the repo root.

# Anthropic — LLM used for classification, summarization, and Q&A
ANTHROPIC_API_KEY=
# LlamaCloud — LlamaParse PDF parsing
LLAMA_CLOUD_API_KEY=

# Supabase Postgres (pgvector) — backend storage + RAG retrieval.
# Use the "Session pooler" connection string from Project Settings → Database,
# including your DB password. Secret — keep it here, never in config.toml.
SUPABASE_DB_URL=

# Supabase frontend client (public, RLS-gated — safe to expose in the Vite SPA build;
# Vite only exposes vars prefixed with VITE_ to the client bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
