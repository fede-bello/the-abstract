# Frontend environment (Vite exposes only VITE_*-prefixed vars to the client).
#
# The SPA reads Supabase (Postgres) directly via the public anon key. Both values are safe to
# expose in the browser: the anon key is gated by row-level security (read-only on public
# arXiv-derived data). Find them in your Supabase project under Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
