# Frontend environment (Vite exposes only VITE_*-prefixed vars to the client).
#
# Data source. Defaults to the in-memory mock client so the app runs with zero backend.
# Set to "false" to talk to a real REST API (not built yet) via VITE_API_BASE_URL.
VITE_USE_MOCK=true

# Base URL of the backend REST API. Only used when VITE_USE_MOCK=false.
VITE_API_BASE_URL=http://localhost:8000
